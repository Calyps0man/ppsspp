if(CMAKE_VERSION VERSION_LESS "3.21")
	message(FATAL_ERROR "The PS3 toolchain requires CMake 3.21+ for SDK link environment setup")
endif()

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR powerpc64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT DEFINED ENV{PS3DEV} OR NOT DEFINED ENV{PPSSPP_PS3_RUNTIME})
	message(FATAL_ERROR "Set PS3DEV and PPSSPP_PS3_RUNTIME (rebuilt thread-enabled libstdc++)")
endif()
file(TO_CMAKE_PATH "$ENV{PS3DEV}" PS3_SDK)
file(TO_CMAKE_PATH "$ENV{PPSSPP_PS3_RUNTIME}" PS3_RUNTIME)
set(CMAKE_C_COMPILER "${PS3_SDK}/ppu/bin/ppu-gcc")
set(CMAKE_CXX_COMPILER "${PS3_SDK}/ppu/bin/ppu-g++")
set(CMAKE_ASM_COMPILER "${PS3_SDK}/ppu/bin/ppu-gcc")
set(CMAKE_AR "${PS3_SDK}/ppu/bin/ppu-ar")
set(CMAKE_RANLIB "${PS3_SDK}/ppu/bin/ppu-ranlib")
set(CMAKE_C_FLAGS_INIT "-I${PS3_SDK}/ppu/include")
set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -I${PS3_RUNTIME}/include/c++/7.2.0 -I${PS3_RUNTIME}/include/c++/7.2.0/powerpc64-ps3-elf -I${CMAKE_CURRENT_LIST_DIR}/runtime/include -I${PS3_SDK}/ppu/include -D_GLIBCXX_GTHREAD_USE_WEAK=0")
# Resolve the rebuilt C++ runtime's pthread references after target archives.
set(CMAKE_CXX_STANDARD_LIBRARIES "-Wl,--start-group -lstdc++ -lpthread -Wl,--end-group")
# GCC's SDK specs need PSL1GHT when linking, even with absolute SDK paths.
set(CMAKE_C_LINKER_LAUNCHER "${CMAKE_COMMAND};-E;env;PSL1GHT=${PS3_SDK}")
set(CMAKE_CXX_LINKER_LAUNCHER "${CMAKE_C_LINKER_LAUNCHER}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${PS3_RUNTIME}/lib -L${PS3_SDK}/ppu/lib -T${PS3_SDK}/ppu/powerpc64-ps3-elf/lib/lv2.ld")
# Each function and variable in its own section, and the linker drops the ones nothing uses: the
# emulator has a lot of code the PS3 build never calls, and the executable is loaded whole into
# main memory, which games need. lv2.ld keeps the sections the system needs (KEEP).
# On unless PS3_GC_SECTIONS=0 is set (in the environment or with -D).
if(NOT DEFINED PS3_GC_SECTIONS AND DEFINED ENV{PS3_GC_SECTIONS})
	set(PS3_GC_SECTIONS "$ENV{PS3_GC_SECTIONS}")
endif()
if(NOT DEFINED PS3_GC_SECTIONS OR PS3_GC_SECTIONS)
	string(APPEND CMAKE_C_FLAGS_INIT " -ffunction-sections -fdata-sections")
	string(APPEND CMAKE_CXX_FLAGS_INIT " -ffunction-sections -fdata-sections")
	string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -Wl,--gc-sections")
endif()
set(CMAKE_FIND_ROOT_PATH "${PS3_RUNTIME}" "${PS3_SDK}/portlibs/ppu" "${PS3_SDK}/ppu")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(PS3 ON CACHE BOOL "Build for PS3 PSL1GHT")
set(HEADLESS_CROSS ON CACHE BOOL "Disable desktop SDL frontend")
set(HEADLESS OFF CACHE BOOL "Build native frontend separately")
# FFmpeg (video, MP3, AAC) is built separately by PS3/ffmpeg/build.sh; point PPSSPP_PS3_FFMPEG at its prefix.
if(DEFINED ENV{PPSSPP_PS3_FFMPEG} AND EXISTS "$ENV{PPSSPP_PS3_FFMPEG}/lib/libavcodec.a")
	set(USE_FFMPEG ON CACHE BOOL "FFmpeg from PPSSPP_PS3_FFMPEG" FORCE)
	file(TO_CMAKE_PATH "$ENV{PPSSPP_PS3_FFMPEG}" PS3_FFMPEG_DIR)
	set(FFMPEG_DIR "${PS3_FFMPEG_DIR}" CACHE PATH "FFmpeg for PS3" FORCE)
else()
	set(USE_FFMPEG OFF CACHE BOOL "No PS3 FFmpeg build (PPSSPP_PS3_FFMPEG)" FORCE)
endif()
set(USE_DISCORD OFF CACHE BOOL "")
set(USE_MINIUPNPC OFF CACHE BOOL "")
set(UNITTEST OFF CACHE BOOL "")
set(ATLAS_TOOL OFF CACHE BOOL "")
set(OPENXR OFF CACHE BOOL "")
set(USE_SYSTEM_LIBPNG OFF CACHE BOOL "")
